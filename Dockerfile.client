# =============================================================================
# Dockerfile.client
# SvelteKit SPA — built with Vite, served by nginx
#
# Uses adapter-static with fallback: 'index.html'.
# nginx proxies /obs /recording /health /ws → the server service.
#
# Context: repo root  (docker build -f Dockerfile.client .)
# =============================================================================

FROM node:22-slim AS builder

WORKDIR /app

# Install all deps (dev included — vite, sveltekit, tailwind are devDeps)
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

# Copy everything vite needs to build the SPA
# (svelte.config.js references client/src, client/static, and shared/)
COPY svelte.config.js vite.config.ts tsconfig.json ./
COPY client/  ./client/
COPY shared/  ./shared/

RUN npm run build


# ── Serve ─────────────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine

# Drop the default config
RUN rm /etc/nginx/conf.d/default.conf

COPY --from=builder /app/build /usr/share/nginx/html
COPY docker/nginx.conf         /etc/nginx/conf.d/app.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
